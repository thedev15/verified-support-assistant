# Default mode is deterministic and does not spend inference credits.
LLM_BACKEND=extractive
KNOWLEDGE_PATH=data/knowledge_base.json
TOP_K=3
MIN_RETRIEVAL_SCORE=0.12

# Set these to use CoreWeave Forge Serverless Inference.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=verified-support-assistant
INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1

# Optional Weave tracing. Set true only after choosing a W&B entity/project.
ENABLE_WEAVE=false
WEAVE_PROJECT=your-team/verified-support-assistant