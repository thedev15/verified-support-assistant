# Copy this file to .env for reference, then load it in your shell.
# The app does not auto-load .env files, which avoids surprising production config.
# Default mode is deterministic and does not spend inference credits.
LLM_BACKEND=extractive
KNOWLEDGE_PATH=data/knowledge_base.json
TOP_K=3
MIN_RETRIEVAL_SCORE=0.12

# Set these to use CoreWeave Forge Serverless Inference.
# Never commit real credentials. The W&B SDK also supports `wandb login`.
WANDB_API_KEY=
WANDB_ENTITY=your-team
WANDB_PROJECT=verified-support-assistant
INFERENCE_MODEL=meta-llama/Llama-3.1-8B-Instruct
INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
INFERENCE_MAX_TOKENS=220
INFERENCE_TEMPERATURE=0

# Optional Weave tracing. Enable only after approving the destination project
# and confirming that submitted support questions may be traced there.
ENABLE_WEAVE=false
WEAVE_PROJECT=your-team/verified-support-assistant